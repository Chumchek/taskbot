# Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# PostgreSQL connection string
DATABASE_URL=postgresql://user:password@localhost:5432/taskbot

# AES-256-GCM key — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_hex_char_key_here

# Comma-separated Telegram user IDs that have admin access
# Get your ID from @userinfobot on Telegram
ADMIN_IDS=123456789,987654321

# Cloudflare R2 — Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=taskbot-media

# ── Deployment (optional) ─────────────────────────────────────────────────────
# Leave blank to use long-polling (development default).
# Set WEBHOOK_URL to your public HTTPS domain to enable webhook mode.
# Railway injects PORT automatically; override only if self-hosting.
# PORT=3000
# WEBHOOK_URL=https://your-app.railway.app